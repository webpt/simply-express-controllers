{
  "name": "simply-express-controllers",
  "version": "2.0.0",
  "description": "Utility library to produce express routers and swagger docs from controller classes.",
  "main": "dist/index.js",
  "types": "dts/index.d.ts",
  "files": [
    "/dist",
    "/dts",
    "/readme.md"
  ],
  "scripts": {
    "clean": "rimraf dist dts",
    "prebuild": "npm run clean",
    "build": "tsc -p src",
    "test": "jest",
    "format": "prettier --write \"./src/**/*.{ts,js}\""
  },
  "keywords": [
    "express",
    "controller",
    "router",
    "typescript",
    "swagger",
    "decorator"
  ],
  "author": {
    "name": "RoboPhred",
    "email": "robophred@gmail.com"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "body-parser": "^1.20.3",
    "http-errors": "^2.0.0",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.0",
    "@types/http-errors": "^1.6.1",
    "@types/jest": "^29.5.12",
    "@types/json-schema": "^7.0.3",
    "@types/lodash": "^4.14.202",
    "@types/node": "^22.8.7",
    "@types/serve-static": "^1.13.10",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.8",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
